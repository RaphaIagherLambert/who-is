# Recognition provider: aws | mock
RECOGNITION_PROVIDER=mock

# AWS Rekognition (required when RECOGNITION_PROVIDER=aws)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Tuned for paused video / TV frames (more recall than studio-photo defaults)
MIN_CONFIDENCE=90
MIN_MATCH_MARGIN=6
MIN_FACE_SIMILARITY=88
MIN_FACE_SHARPNESS=20
MAX_POSE_YAW=50
MAX_POSE_PITCH=45

# Reject obviously blurry/dark JPEGs locally before calling AWS
PRE_AWS_QUALITY_ENABLED=true
PRE_AWS_MIN_SHARPNESS=12
PRE_AWS_MIN_BRIGHTNESS=10
PRE_AWS_MAX_BRIGHTNESS=250

# Auto-crop the main face before collection/celebrity search (no manual zoom)
FACE_CROP_ENABLED=true

# Admin teach mode — use 32+ random characters in production (see SECURITY.md)
ADMIN_SECRET=change-me-to-a-long-random-string
REKOGNITION_COLLECTION_ID=who-is-faces
CUSTOM_TEACH_ENABLED=true

# Security (production defaults lock to who-is.onrender.com)
# CORS_ORIGINS=https://who-is.onrender.com,https://your-custom-domain.com
# RATE_LIMIT_IDENTIFY_MAX=40
# RATE_LIMIT_IDENTIFY_WINDOW_MS=900000
# RATE_LIMIT_ADMIN_MAX=10
# RATE_LIMIT_WIKI_MAX=80

# Server port
PORT=3001
