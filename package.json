{
  "name": "public-figure-spotter",
  "version": "1.0.0",
  "private": true,
  "description": "Who is? — identify public figures and open Wikipedia",
  "scripts": {
    "install:all": "npm install --prefix client --include=dev && npm install --prefix server --include=dev",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "npm run dev --prefix client",
    "dev:server": "npm run dev --prefix server",
    "build": "npm run build --prefix client && npm run build --prefix server",
    "start": "npm run start --prefix server",
    "import:actors": "npm run import:actors --prefix server --",
    "import:actors:dry-run": "npm run import:actors --prefix server -- --dry-run --limit 5",
    "import:actors:sparql": "npm run import:actors:sparql --prefix server",
    "import:musicians": "npm run import:musicians --prefix server --",
    "import:musicians:dry-run": "npm run import:musicians --prefix server -- --dry-run --limit 5",
    "import:musicians:sparql": "npm run import:musicians:sparql --prefix server",
    "import:musicians:sparql:20": "npm run import:musicians:sparql:20 --prefix server",
    "import:eu-actors": "npm run import:eu-actors --prefix server --",
    "import:eu-actors:dry-run": "npm run import:eu-actors --prefix server -- --dry-run --limit 5",
    "import:eu-actors:sparql": "npm run import:eu-actors:sparql --prefix server",
    "import:eu-musicians": "npm run import:eu-musicians --prefix server --",
    "import:eu-musicians:dry-run": "npm run import:eu-musicians --prefix server -- --dry-run --limit 5",
    "import:eu-musicians:sparql": "npm run import:eu-musicians:sparql --prefix server"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
