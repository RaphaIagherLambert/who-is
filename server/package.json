{
  "name": "public-figure-spotter-server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && node scripts/copy-wikidata-index.mjs",
    "start": "node dist/index.js",
    "import:actors": "tsx scripts/import-us-actors.ts",
    "import:actors:sparql": "tsx scripts/import-us-actors.ts -- --mode sparql --limit 5 --batch-size 3",
    "import:musicians": "tsx scripts/import-us-musicians.ts",
    "import:musicians:sparql": "tsx scripts/import-us-musicians.ts -- --mode sparql --limit 5 --batch-size 3",
    "import:musicians:sparql:20": "tsx scripts/import-us-musicians.ts -- --mode sparql --limit 20 --batch-size 5",
    "import:us-influencers": "tsx scripts/import-us-influencers.ts",
    "import:us-influencers:sparql": "tsx scripts/import-us-influencers.ts -- --mode sparql --limit 5 --batch-size 3",
    "import:eu-actors": "tsx scripts/import-eu-actors.ts",
    "import:eu-actors:sparql": "tsx scripts/import-eu-actors.ts -- --mode sparql --limit 5 --batch-size 3",
    "import:eu-musicians": "tsx scripts/import-eu-musicians.ts",
    "import:eu-musicians:sparql": "tsx scripts/import-eu-musicians.ts -- --mode sparql --limit 5 --batch-size 3",
    "import:eu-influencers": "tsx scripts/import-eu-influencers.ts",
    "import:eu-influencers:sparql": "tsx scripts/import-eu-influencers.ts -- --mode sparql --limit 5 --batch-size 3",
    "import:br-actors": "tsx scripts/import-br-actors.ts",
    "import:br-actors:sparql": "tsx scripts/import-br-actors.ts -- --mode sparql --limit 5 --batch-size 3",
    "import:br-musicians": "tsx scripts/import-br-musicians.ts",
    "import:br-musicians:sparql": "tsx scripts/import-br-musicians.ts -- --mode sparql --limit 5 --batch-size 3",
    "import:br-influencers": "tsx scripts/import-br-influencers.ts",
    "import:br-influencers:sparql": "tsx scripts/import-br-influencers.ts -- --mode sparql --limit 5 --batch-size 3",
    "import:latam-actors": "tsx scripts/import-latam-actors.ts",
    "import:latam-actors:sparql": "tsx scripts/import-latam-actors.ts -- --mode sparql --limit 5 --batch-size 3",
    "import:latam-musicians": "tsx scripts/import-latam-musicians.ts",
    "import:latam-musicians:sparql": "tsx scripts/import-latam-musicians.ts -- --mode sparql --limit 5 --batch-size 3",
    "import:asia-actors": "tsx scripts/import-asia-actors.ts",
    "import:asia-actors:sparql": "tsx scripts/import-asia-actors.ts -- --mode sparql --limit 5 --batch-size 3",
    "import:asia-musicians": "tsx scripts/import-asia-musicians.ts",
    "import:asia-musicians:sparql": "tsx scripts/import-asia-musicians.ts -- --mode sparql --limit 5 --batch-size 3",
    "security:check": "node scripts/check-secrets.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-rekognition": "^3.787.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "jpeg-js": "^0.4.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/node": "^22.15.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
